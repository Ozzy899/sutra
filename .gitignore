# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local cloud-agent upload artifacts
/uploads/
/agent-tools/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.sutra-keys.json


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# convex local CLI state (never commit admin keys or CONVEX_DEPLOY_KEY)
.convex/
